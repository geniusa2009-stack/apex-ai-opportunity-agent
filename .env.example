# --- Core Video Media Processing Pipeline & Intelligent Recommendation
# Engine (built on top of Ecosystem Features 13 & 14) ---
# Pinata JWT (modern auth method) -- Pinata dashboard -> API Keys ->
# "New Key" -> copy the JWT. Verify against https://docs.pinata.cloud
# before assuming this is still their recommended auth method.
PINATA_JWT=
# Shared public gateway by default; override with a dedicated Pinata
# gateway domain for better performance/reliability in production.
PINATA_GATEWAY_URL=
# Cosine DISTANCE cutoff (smaller = more relevant) for the
# recommendation engine -- reasonable starting default, not a validated
# number; see the comment on this setting in app/core/config.py.
