# --- Postgres (Supabase, as of the Supabase integration step) ---
# For local Docker Compose dev without Supabase, these POSTGRES_* values
# still spin up a local `db` container as before -- but DATABASE_URL /
# SYNC_DATABASE_URL below are what the app actually reads, and should be
# pointed at your real Supabase project's connection strings for anything
# beyond throwaway local dev.
POSTGRES_USER=apex
POSTGRES_PASSWORD=changeme
POSTGRES_DB=apex_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async URL used by the FastAPI app (SQLAlchemy + asyncpg). For Supabase,
# get this from Project Settings -> Database -> Connection string ->
# "URI" (direct connection, port 5432) and swap the scheme prefix to
# `postgresql+asyncpg://` -- Supabase's own copy-paste string uses plain
# `postgresql://`, which SQLAlchemy's async engine can't use directly.
# If you instead use Supabase's pgbouncer transaction-mode pooler (port
# 6543) for serverless-friendly pooling, see the comment in
# app/db/session.py -- it needs an extra `connect_args` tweak to disable
# asyncpg's prepared-statement cache, or every second query will fail.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apex_db

# Sync URL used only by Alembic migrations (SQLAlchemy + psycopg2). Same
# Supabase connection string as above, but with `postgresql+psycopg2://`
# and (for Alembic specifically) the direct connection on port 5432, not
# the pooler -- DDL statements like migrations generally shouldn't run
# through a transaction-mode pooler.
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/apex_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ---
ENVIRONMENT=development
# No longer used to sign anything (the local JWT issuer was removed as
# part of the Supabase integration step -- see SUPABASE_JWT_SECRET
# below, which replaced it). Left in place since Settings still declares
# it and pydantic-settings will error on a genuinely missing required
# field; harmless to leave a placeholder value here.
SECRET_KEY=changeme
API_V1_PREFIX=/api/v1

# --- CORS (APEX Staging Deployment Readiness step) ---
# Comma-separated list of EXACT allowed origins, e.g.
# "https://staging-apex.vercel.app" -- never a wildcard. Leave empty for
# same-origin deployments (the frontend calling this API via a relative
# path on the same domain, this app's architecture to date) or for
# local dev with no separate frontend origin. Only set this when the
# frontend is actually deployed to a DIFFERENT origin than this API.
CORS_ORIGINS=

# --- Auth (Step 3.2 originally; superseded by Supabase JWT verification) ---
JWT_ALGORITHM=HS256
# No longer used (governed the removed local `create_access_token`) --
# see the comment on SECRET_KEY above for why this stays declared anyway.
ACCESS_TOKEN_EXPIRE_MINUTES=changeme

# --- Supabase JWT verification (Supabase integration step) ---
# Project Settings -> API -> JWT Settings -> "JWT Secret" in the Supabase
# dashboard. Used to verify the signature of Supabase-issued access
# tokens locally (HS256, matching JWT_ALGORITHM above) -- no network call
# to Supabase is needed to validate a token, only to look up the secret
# once at deploy time.
SUPABASE_JWT_SECRET=changeme

# --- AI providers (used starting Phase 2) ---
ANTHROPIC_API_KEY=changeme
OPENAI_API_KEY=changeme
AI_VERIFICATION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONFIDENCE_THRESHOLD=0.7

# --- Anthropic document generation (Step 3.3) ---
# Model IDs move on; verify this is still current before relying on it.
ANTHROPIC_DOCUMENT_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=changeme
ANTHROPIC_DOCUMENT_TEMPERATURE=0.7

# --- Gemini vision / document extraction (Step 3.4) ---
# Free tier as of this build -- verify model name and current free-tier
# terms at https://ai.google.dev/gemini-api/docs/pricing before relying on
# either staying true.
GEMINI_API_KEY=changeme
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Gemini essay/letter grader (Step 3.8 / Feature 4) ---
# Same model as above by default; kept as a separate setting so it can be
# tuned independently of vision/document extraction.
GEMINI_GRADING_MODEL=gemini-2.5-flash

# --- Gemini roadmap planner (Step 3.9 / Feature 5) ---
