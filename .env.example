# --- Groq chatbot (Step 3.5) ---
# Groq's free Llama lineup has been deprecated in stages through 2025-2026;
# openai/gpt-oss-20b is Groq's current recommended free-tier replacement.
# Verify at https://console.groq.com/docs/models before relying on this.
GROQ_API_KEY=changeme
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# --- Groq Whisper speech-to-text (Step 3.16 / Advanced Feature 2) ---
# whisper-large-v3 is confirmed NOT deprecated as of this build (unlike
# the chat models above) -- whisper-large-v3-turbo is a faster
# alternative. Free tier accepts audio files up to 25MB. Verify at
# https://console.groq.com/docs/speech-to-text before relying on this.
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Semantic search (Step 3.1) ---
SEARCH_SIMILARITY_THRESHOLD=0.5

# --- Enterprise-Grade AI Memory & Cloud Vault System integration step
# (no step number -- an infrastructure step, like the Supabase DB/JWT
# integration above) ---

# Supabase Storage. Project Settings -> API in the Supabase dashboard for
# both values. SUPABASE_URL is the project's REST/Storage API base
# (distinct from DATABASE_URL above, which is the Postgres connection
# string -- Storage talks HTTP, not the Postgres wire protocol).
# SUPABASE_SERVICE_ROLE_KEY (NOT the anon/public key) -- keep this
# server-side only, it bypasses Storage's Row Level Security. See the
# comment on `supabase_service_role_key` in app/core/config.py for why
# the service role key specifically is used here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme

# Gemini text embeddings for StudentMemory -- deliberately a different
# model/dimensionality (768-dim) than AI_EMBEDDING_MODEL above (OpenAI's
# text-embedding-3-small, 1536-dim, used for the public Opportunity
# catalog). See app/services/memory_service.py.
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Gemini call that condenses a raw saved artifact into the short semantic
# summary text that then gets embedded -- necessary plumbing not
# literally named in the ask; see the comment on this setting in
# app/core/config.py.
GEMINI_MEMORY_SUMMARIZER_MODEL=gemini-2.5-flash

