from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.security import OAuth2PasswordRequestForm
from sqlalchemy import select

from app.api.deps import DbSession
from app.core.security import create_access_token, hash_password, verify_password
from app.models.user import User
from app.schemas.user import Token, UserCreate, UserOut

router = APIRouter(prefix="/auth", tags=["auth"])

# Computed once at import time and compared against whenever no user is
# found by the given email. Without this, verify_password() would only run
# on the "user exists but wrong password" path, making "no such account"
# responses measurably faster than "wrong password" ones -- an easy
# account-enumeration side channel via response timing. Always running a
# bcrypt comparison, real hash or not, keeps both paths the same shape.
_DUMMY_HASH = hash_password("not-a-real-password-used-only-for-timing-safety")


@router.post("/register", response_model=UserOut, status_code=status.HTTP_201_CREATED)
async def register(payload: UserCreate, db: DbSession) -> User:
    # Normalize case so "User@Example.com" and "user@example.com" are
    # treated as the same account. The `users.email` column itself is a
    # plain (case-sensitive) unique VARCHAR -- doing this in the app layer
    # avoids needing a migration (citext, or a functional unique index on
    # lower(email)) for something cheap to enforce here instead.
    email = payload.email.lower()

    existing = await db.execute(select(User).where(User.email == email))
    if existing.scalar_one_or_none() is not None:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="An account with this email already exists",
        )

    user = User(
        email=email,
        hashed_password=hash_password(payload.password),
        full_name=payload.full_name,
    )
    db.add(user)
    await db.commit()
    await db.refresh(user)
    return user


@router.post("/login", response_model=Token)
async def login(
    form_data: Annotated[OAuth2PasswordRequestForm, Depends()], db: DbSession
) -> Token:
    # OAuth2PasswordRequestForm's field is always called "username" per the
    # OAuth2 spec / FastAPI's form model -- we treat it as the user's email.
    email = form_data.username.lower()

    result = await db.execute(select(User).where(User.email == email))
    user = result.scalar_one_or_none()

    # See _DUMMY_HASH above: this runs a real bcrypt verify regardless of
    # whether `user` was found, so the two failure cases below take
    # indistinguishable time.
    hashed = user.hashed_password if user is not None else _DUMMY_HASH
    password_ok = verify_password(form_data.password, hashed)

    if user is None or not password_ok:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Incorrect email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )
    if not user.is_active:
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Inactive user")

    access_token = create_access_token(subject=user.id)
    return Token(access_token=access_token)
